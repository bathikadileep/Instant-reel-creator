# ==============================================================================
# Instant Reel - Backend Environment Configuration
# ==============================================================================

# Project Details
PROJECT_NAME="Instant Reel API"
ENVIRONMENT="development" # development | staging | production
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Neon PostgreSQL Database Configuration
# Format: postgresql+asyncpg://<user>:<password>@<neon_host>/<dbname>?ssl=require
# For Alembic/Sync: postgresql://<user>:<password>@<neon_host>/<dbname>?sslmode=require
DATABASE_URL="postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?ssl=require"
SYNC_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & JWT Authentication
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="replace_with_a_super_secret_cryptographically_secure_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# CORS Settings (Comma-separated list of allowed origins)
# For local Flutter development: http://localhost:*, chrome-extension://*, etc.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","http://127.0.0.1:8000","*"]
