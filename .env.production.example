# ==============================================================================
# Instant Reel Platform — Production Environment Variables
# Copy to .env or inject into your cloud provider (Render / Railway / AWS)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="Instant Reel API"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# Neon PostgreSQL Database Configuration (Serverless AWS/GCP)
# Obtain these from your Neon Console: https://console.neon.tech
# ==============================================================================
# ASYNC Connection String (Used by FastAPI / SQLAlchemy async engine)
# Must start with: postgresql+asyncpg:// and include ?ssl=require
DATABASE_URL=postgresql+asyncpg://<username>:<password>@ep-soft-credit-a1281h19.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# SYNC Connection String (Used by Alembic migrations)
# Must start with: postgresql:// and include ?sslmode=require
SYNC_DATABASE_URL=postgresql://<username>:<password>@ep-soft-credit-a1281h19.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings (Tuned for Neon Serverless autoscaling)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# Security & JWT Authentication
# Generate a strong 64-character secret: openssl rand -hex 32
# ==============================================================================
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURITY_HEADERS_ENABLED=True

# ==============================================================================
# CORS Allowed Domains (Comma-separated)
# ==============================================================================
CORS_ORIGINS=https://instant-reel-admin.onrender.com,http://localhost:3000

# ==============================================================================
# Logging, Monitoring & Observability
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_METRICS_ENABLED=True

# Sentry Error Tracking & APM (https://sentry.io)
SENTRY_DSN=https://<public_key>@o<org_id>.ingest.sentry.io/<project_id>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ==============================================================================
# Razorpay Payment Gateway (Phase 8)
# https://dashboard.razorpay.com/#/app/keys
# ==============================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=yyyyyyyyyyyyyyyyyyyyyyyy
RAZORPAY_WEBHOOK_SECRET=zzzzzzzzzzzzzzzzzzzzzzzz

# ==============================================================================
# Firebase Cloud Messaging (Phase 10)
# Provide either the JSON string or file path
# ==============================================================================
FCM_ENABLED=True
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"instant-reel","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@instant-reel.iam.gserviceaccount.com"}

# ==============================================================================
# Admin Panel Build Variables (React Vite)
# ==============================================================================
VITE_API_BASE_URL=https://instant-reel-api.onrender.com/api/v1
