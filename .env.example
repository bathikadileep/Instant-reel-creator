# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Instant Reel API"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (Neon PostgreSQL or local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/instant_reel
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instant_reel

# Security
JWT_SECRET_KEY=local_dev_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,*

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=text
PROMETHEUS_METRICS_ENABLED=True
SENTRY_DSN=

# Payment Gateway (Mock keys for development)
RAZORPAY_KEY_ID=rzp_test_instantreel_mock
RAZORPAY_KEY_SECRET=instantreel_mock_secret_key_12345
RAZORPAY_WEBHOOK_SECRET=instantreel_webhook_secret_67890

# Push Notifications (Mock mode when empty)
FCM_ENABLED=True
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin Panel
VITE_API_BASE_URL=http://localhost:8000/api/v1
